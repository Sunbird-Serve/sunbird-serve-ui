# API Configuration — sandbox
VITE_API_BASE_URL_NEED=https://serve-v1.evean.net
VITE_API_BASE_URL_FULFILL=https://serve-v1.evean.net
VITE_API_BASE_URL_VOLUNTEERING=https://serve-v1.evean.net

# Keycloak — sandbox
VITE_KEYCLOAK_URL=https://auth.serve-v1.evean.net
VITE_KEYCLOAK_REALM=sunbird-serve
VITE_KEYCLOAK_CLIENT_ID=serve-ui

# Volunteer Agent
VITE_VOLUNTEER_AGENT_WEB_URL=https://serve-ai.evean.net
VITE_VOLUNTEER_AGENT_WHATSAPP_URL=https://wa.me/918951554442?text=I%20would%20like%20to%20volunteer

# Adopter/deployment identity — drives home page content.
# Supported: telangana | up | samudaya | default
VITE_ADOPTER=samudaya

# SERVE Samudaya (Community Edition) deployment settings.
# Organisation "Express interest" submissions are delivered using whichever of
# the following is configured, in priority order:
#   1. VITE_SAMUDAYA_INTEREST_ENDPOINT — POST submission as JSON (Formspree,
#      Google Apps Script web app, or a future API). Must accept CORS + JSON.
#   2. VITE_SAMUDAYA_CONTACT_EMAIL — fallback: compose a prefilled mailto:.
#   3. Neither — the interest form renders disabled with a clear notice.
VITE_SAMUDAYA_INTEREST_ENDPOINT=https://formspree.io/f/xvkkwlee
VITE_SAMUDAYA_CONTACT_EMAIL=sowmya.raghuram@evidyaloka.org
# Optional public links for the footer / trust section. Leave blank to hide.
VITE_SAMUDAYA_PRIVACY_URL=
VITE_SAMUDAYA_TERMS_URL=
VITE_SUNBIRD_SERVE_URL=https://github.com/Sunbird-Serve

# Volunteer onboarding channel toggles (per-deployment)
VITE_VOLUNTEER_WEB_ENABLED=true
VITE_VOLUNTEER_WHATSAPP_ENABLED=true

# Default agency a self-registering volunteer is attached to when no
# agency is supplied via the /register/:agencyId deep link.
VITE_DEFAULT_VOLUNTEER_AGENCY_ID=1-74f81200-dc16-4c65-bf7a-a3ab75952432
